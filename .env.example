# Server-side secret (set in Vercel Project Environment Variables and local .env only — NEVER prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# Public backend URL injected into the static frontend at build time (GitHub Actions Variables/Secrets & .env.local)
VITE_AI_BACKEND_URL=https://your-vercel-backend.vercel.app
